# ---------------------------------------------------------------------------
# RFP Use Case Extractor - example configuration
#
# HOW TO USE
#   1. Copy this file and name the copy ".env"  (Windows: copy .env.example .env)
#   2. Put your real Gemini API key in GOOGLE_API_KEY
#   3. Never commit the real .env file to Git - .gitignore already excludes it.
# ---------------------------------------------------------------------------

# Your Gemini API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Set to true to run the whole application WITHOUT calling Gemini.
# Sample requirements are used instead. No API key needed, no cost.
USE_MOCK_DATA=false

# --- Optional tuning (sensible defaults are used if you delete these) -------

# Gemini model used for extraction
GEMINI_MODEL=gemini-2.5-flash

# 0.0 keeps the output as repeatable as possible - important for extraction
GEMINI_TEMPERATURE=0.0

# Seconds to wait for one Gemini response
GEMINI_TIMEOUT_SECONDS=180

# How many times a failed batch is retried before it is reported to the user
GEMINI_MAX_RETRIES=3

# Approximate characters of RFP text sent in one request.
# Lower it if you hit timeouts; raise it to make large documents faster.
BATCH_CHAR_BUDGET=45000

# A page with fewer characters than this is treated as visually empty
MIN_CHARS_PER_PAGE=25

# Largest PDF the app will accept, in megabytes
MAX_UPLOAD_MB=50

# Folder for generated files
OUTPUT_DIR=outputs

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
